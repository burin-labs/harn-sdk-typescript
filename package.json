{
  "name": "@burin-labs/harn",
  "version": "0.1.0-alpha.0",
  "description": "TypeScript SDK for the Harn Agents API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "spec/openapi.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:built-package": "node scripts/check-built-package.mjs",
    "check:examples": "tsc -p tsconfig.examples.json",
    "check:tests": "tsc -p tsconfig.test.json",
    "example:express": "tsx examples/express-provider-catalog.ts",
    "check:protocol": "node scripts/check-protocol-artifact.mjs",
    "generate:types": "openapi-typescript spec/openapi.yaml -o src/generated/openapi.ts",
    "normalize:protocol": "node scripts/normalize-protocol-artifact.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "pnpm build",
    "publish:alpha": "npm publish --access public --tag alpha",
    "publish:latest": "npm publish --access public --tag latest",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version:alpha": "npm version prerelease --preid alpha",
    "version:major": "npm version major",
    "version:minor": "npm version minor",
    "version:patch": "npm version patch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burin-labs/harn-sdk-typescript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
